generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String        @id @default(uuid())
  name          String        @unique
  country       Country?      @default(BANGLADESH)
  cardDamageFee Decimal       @default(0) @db.Decimal(10, 2)
  creatorId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  creator       Staff?        @relation("OrgCreator", fields: [creatorId], references: [id])
  staffs        Staff[]
  counters      Counter[]
  serviceTypes  ServiceType[]
  services      Service[]
  cards         Card[]
  users         User[]
  transactions  Transaction[]
  events        Event[]
  eventQuotas   EventQuota[]
  subscription  Subscription?

  @@map("organization")
}

model Staff {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  phone          String        @unique
  password       String
  image          String?
  role           Role          @default(OPERATOR)
  isActive       Boolean       @default(true)
  counterId      String?
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  services       Service[]
  counter        Counter?      @relation(fields: [counterId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  transactions   Transaction[]
  createdOrgs    Organization[] @relation("OrgCreator")

  @@map("staff")
}

model Counter {
  id             String        @id @default(uuid())
  name           String        @unique
  isActive       Boolean       @default(true)
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  service        Service[]
  staff          Staff[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  transactions   Transaction[]

  @@index([isActive])
  @@map("counter")
}

model ServiceType {
  id             String        @id @default(uuid())
  name           String        @unique
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  service        Service[]
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("serviceType")
}

model Service {
  id            String        @id @default(uuid())
  name          String        @unique
  price         Decimal       @db.Decimal(10, 2)
  isActive      Boolean       @default(true)
  image         String?
  description   String?
  quantity      Int?
  usedQuantity  Int?          @default(0)
  staffId       String?
  serviceTypeId String
  counterId     String?
  organizationId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  eventQuotas   EventQuota[]
  counter       Counter?      @relation(fields: [counterId], references: [id])
  serviceType   ServiceType   @relation(fields: [serviceTypeId], references: [id])
  staff         Staff?        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  organization  Organization? @relation(fields: [organizationId], references: [id])
  transactions  Transaction[]

  @@index([serviceTypeId, staffId])
  @@map("service")
}

model Card {
  id                String              @id @default(uuid())
  cardUid           String?             @unique
  cardCode          String?             @unique
  type              CardType
  status            CardStatus          @default(INACTIVE)
  currentUserId     String?
  organizationId    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User?               @relation(fields: [currentUserId], references: [id])
  organization      Organization?       @relation(fields: [organizationId], references: [id])
  transactions      Transaction[]
  virtualCardAccess VirtualCardAccess[]

  @@index([status, type])
  @@index([cardUid])
  @@index([currentUserId])
  @@map("card")
}

model User {
  id                String              @id @default(uuid())
  phone             String              @unique
  name              String?
  email             String?
  balance           Decimal             @default(0) @db.Decimal(12, 2)
  status            UserStatus          @default(ACTIVE)
  userType          UserType            @default(REGULAR)
  userPresent       Json?
  previousName      Json?
  previousEmail     Json?
  previousEventId   Json?
  pinHash           String?
  isPinSet          Boolean             @default(false)
  organizationId    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  activeEventId     String?
  cards             Card[]
  transactions      Transaction[]
  virtualCardAccess VirtualCardAccess[]
  activeEvent       Event?              @relation(fields: [activeEventId], references: [id])
  organization      Organization?       @relation(fields: [organizationId], references: [id])

  @@map("user")
}

model Transaction {
  id             String        @id @default(uuid())
  userId         String
  cardId         String
  serviceId      String?
  type           TransType
  amount         Decimal       @db.Decimal(10, 2)
  quantity       Int           @default(1)
  eventId        String?
  staffId        String?
  organizationId String?
  balanceBefore  Decimal       @db.Decimal(12, 2)
  balanceAfter   Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  counterId      String?
  card           Card          @relation(fields: [cardId], references: [id])
  counter        Counter?      @relation(fields: [counterId], references: [id])
  event          Event?        @relation(fields: [eventId], references: [id])
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff          Staff?        @relation(fields: [staffId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([cardId, createdAt])
  @@index([userId, createdAt])
  @@index([eventId, type])
  @@index([staffId])
  @@index([counterId])
  @@map("transaction")
}

model Event {
  id             String        @id @default(uuid())
  name           String        @unique
  startDate      DateTime
  endDate        DateTime
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  status         eventStatus   @default(ACTIVE)
  eventQuotas    EventQuota[]
  transactions   Transaction[]
  activeUsers    User[]
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("event")
}

model EventQuota {
  id               String        @id @default(uuid())
  eventId          String
  serviceId        String
  organizationId   String?
  maxUsesPerPerson Int           @default(1)
  usedCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service          Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  organization     Organization? @relation(fields: [organizationId], references: [id])

  @@unique([eventId, serviceId])
  @@map("event_quota")
}

model VirtualCardAccess {
  id          String   @id @default(uuid())

  userId      String
  cardId      String

  phone       String
  token       String   @unique

  status      NotificationStatus @default(PENDING)

  isUsed      Boolean  @default(false)
  usedAt      DateTime?

  expiresAt   DateTime

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  card        Card     @relation(fields: [cardId], references: [id])

  @@index([phone])
  @@index([token])
  @@map("virtual_card_access")
}



model SubscriptionPlan {
  id             String         @id @default(uuid())
  name           String         @unique
  description    String?
  price          Decimal        @db.Decimal(10, 2)
  billingCycle   BillingCycle   @default(MONTHLY)
  maxUsers       Int            @default(100)
  maxEvents      Int            @default(10)
  maxStaffs      Int            @default(10)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]

  @@map("subscription_plan")
}

model Subscription {
  id             String                @id @default(uuid())
  organizationId String                @unique
  planId         String
  status         SubscriptionStatus    @default(TRIAL)
  startDate      DateTime              @default(now())
  endDate        DateTime
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id])
  plan           SubscriptionPlan      @relation(fields: [planId], references: [id])
  payments       SubscriptionPayment[]

  @@map("subscription")
}

model SubscriptionPayment {
  id                 String         @id @default(uuid())
  subscriptionId     String
  amount             Decimal        @db.Decimal(10, 2)
  status             PaymentStatus  @default(PENDING)
  paymentMethod      String
  transactionId      String         @unique
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  createdAt          DateTime       @default(now())
  subscription       Subscription   @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_payment")
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum Role {
  SUPER_ADMIN
  MANAGER
  ADMIN
  OPERATOR
}

enum CardType {
  NFC
  RFID
  VIRTUAL
}

enum CardStatus {
  ACTIVE
  INACTIVE
  LOST
}

enum TransType {
  TOPUP
  USAGE
  REFUND
  PENALTY
}

enum NotifyChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
  PENDING
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Country {
  BANGLADESH
  GLOBAL
}

enum eventStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum UserType {
  REGULAR
  EVENT_USER
}
